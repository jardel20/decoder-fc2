{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FC2 Explorer",
  "version": "0.2.2",
  "identifier": "io.github.jardel20.fc2explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "FC2 Explorer", "width": 1240, "height": 820, "minWidth": 800, "minHeight": 620, "backgroundColor": "#f5f6f8" }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "linux": {
      "appimage": {
        "files": {
          "usr/lib/libgpg-error.so.0": "/usr/lib/x86_64-linux-gnu/libgpg-error.so.0",
          "usr/lib/libgmp.so.10": "/usr/lib/x86_64-linux-gnu/libgmp.so.10",
          "usr/lib/libcom_err.so.2": "/usr/lib/x86_64-linux-gnu/libcom_err.so.2"
        }
      }
    }
  }
}
